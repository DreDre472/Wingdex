GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
EBIRD_API_KEY=your-ebird-api-key
PORT=3001
CORS_ORIGIN=http://your-locallhost:0000

# Public key for client-side Supabase setup; this is safe to expose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase secret key. Never expose this key in the mobile app.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Comma-separated Supabase Auth user UUIDs allowed to use /admin/* endpoints.
# This server-side allowlist is the admin authority; profile metadata is ignored.
ADMIN_USER_IDS=your-admin-user-uuid
